<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Crono" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#0F1218</item>
        <item name="android:statusBarColor">#0F1218</item>
        <item name="android:navigationBarColor">#0F1218</item>
    </style>

    <style name="Theme.Crono.Splash" parent="android:Theme.Material.Light.NoActionBar">
